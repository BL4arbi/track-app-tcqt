PORT=4000
NODE_ENV=development

DATABASE_URL=postgres://postgres:postgres@localhost:5432/solidworks_tracker

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Restrict signup to this email domain
ALLOWED_EMAIL_DOMAIN=tacquet-industries.fr

# Base URL the frontend runs on, used to build the password-reset link
# (that flow needs a form, so it must go through the frontend)
APP_BASE_URL=http://localhost:5173

# Base URL this backend is reachable at, used to build the email-verification
# link — that one is a plain click-to-confirm, so it's handled entirely by
# the backend itself and never depends on the frontend being up
API_BASE_URL=http://localhost:4000

# SMTP for verification / password reset emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SolidWorks Tracker <no-reply@tacquet-industries.fr>"

UPLOAD_DIR=./uploads
