PORT=4000
NODE_ENV=development

DATABASE_URL=postgres://postgres:postgres@localhost:5432/solidworks_tracker

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Restrict signup to this email domain, e.g. "yourdomain.com"
ALLOWED_EMAIL_DOMAIN=yourdomain.com

# Base URL the frontend runs on, used to build verification/reset links
APP_BASE_URL=http://localhost:5173

# SMTP for verification / password reset emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SolidWorks Tracker <no-reply@yourdomain.com>"

UPLOAD_DIR=./uploads
